* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #f4f7f6;
  color: #333;
}

.header {
  background-color: #1a365d;
  color: white;
  padding: 20px;
  text-align: center;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.header h1 {
  font-size: 24px;
  margin-bottom: 5px;
}

.header p {
  font-size: 14px;
  color: #cbd5e0;
}

.container {
  max-width: 1000px;
  margin: 30px auto;
  padding: 0 20px;
}

.search-card {
  background: white;
  padding: 25px;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  margin-bottom: 25px;
}

.search-box {
  display: flex;
  gap: 10px;
  margin-top: 15px;
}

.search-box input {
  flex: 1;
  padding: 12px 15px;
  border: 1px solid #cbd5e0;
  border-radius: 6px;
  font-size: 16px;
  text-transform: uppercase;
}

.search-box button {
  padding: 12px 25px;
  background-color: #2b6cb0;
  color: white;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 16px;
  font-weight: bold;
}

.search-box button:hover {
  background-color: #2c5282;
}

.tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.tab-btn {
  padding: 10px 20px;
  border: none;
  background-color: #e2e8f0;
  cursor: pointer;
  border-radius: 6px;
  font-weight: 600;
}

.tab-btn.active {
  background-color: #2b6cb0;
  color: white;
}

.result-card {
  background: white;
  padding: 25px;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

.student-info {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
  margin-bottom: 20px;
  background-color: #f7fafc;
  padding: 15px;
  border-radius: 6px;
}

.student-info div span {
  display: block;
  font-size: 12px;
  color: #718096;
}

.student-info div strong {
  font-size: 16px;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 15px;
}

th, td {
  padding: 12px;
  text-align: left;
  border-bottom: 1px solid #e2e8f0;
}

th {
  background-color: #ebf8ff;
  color: #2b6cb0;
}

.badge-pass {
  color: #2f855a;
  background-color: #c6f6d5;
  padding: 4px 8px;
  border-radius: 4px;
  font-weight: bold;
  font-size: 12px;
}

.badge-fail {
  color: #9b2c2c;
  background-color: #fed7d7;
  padding: 4px 8px;
  border-radius: 4px;
  font-weight: bold;
  font-size: 12px;
}

.summary {
  display: flex;
  justify-content: space-between;
  margin-top: 20px;
  padding-top: 15px;
  border-top: 2px solid #e2e8f0;
}

.all-students {
  margin-top: 30px;
}