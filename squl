-- Create Database
CREATE DATABASE IF NOT EXISTS svpcet_results;
USE svpcet_results;

-- Students Table
CREATE TABLE IF NOT EXISTS students (
    roll_number VARCHAR(12) PRIMARY KEY,
    student_name VARCHAR(100) NOT NULL,
    branch VARCHAR(100) DEFAULT 'B.TECH (ARTIFICIAL INTELLIGENCE)'
);

-- Results Summary Table
CREATE TABLE IF NOT EXISTS semester_results (
    id INT AUTO_INCREMENT PRIMARY KEY,
    roll_number VARCHAR(12),
    semester INT NOT NULL,
    sgpa DECIMAL(3,2),
    FOREIGN KEY (roll_number) REFERENCES students(roll_number) ON DELETE CASCADE
);

-- Subject Grade Details Table
CREATE TABLE IF NOT EXISTS subject_grades (
    id INT AUTO_INCREMENT PRIMARY KEY,
    roll_number VARCHAR(12),
    semester INT NOT NULL,
    sub_code VARCHAR(20) NOT NULL,
    subject_name VARCHAR(150) NOT NULL,
    internal_marks INT,
    external_marks VARCHAR(10),
    total_marks INT,
    credits DECIMAL(3,2),
    grade VARCHAR(5),
    result_status VARCHAR(10),
    FOREIGN KEY (roll_number) REFERENCES students(roll_number) ON DELETE CASCADE
);

